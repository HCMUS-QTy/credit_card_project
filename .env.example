# ============================
# KAFKA
# ============================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=credit-card-transactions
CSV_FILE=data/User0_credit_card_transactions.csv
PRODUCER_DELAY_MIN_SECONDS=1
PRODUCER_DELAY_MAX_SECONDS=5
# ============================
# OUTBOX
# ============================
OUTBOX_DB_PATH=data/pos_outbox.sqlite3
# ============================
# SPARK STREAMING
# ============================
SPARK_MASTER=local[2]
SPARK_KAFKA_PACKAGE=org.apache.spark:spark-sql-kafka-0-10_2.12:3.5.0

# ============================
# HADOOP HDFS
# ============================
HDFS_BASE_PATH=/user/hdoop/credit_card_project
HDFS_CHECKPOINT_PATH=/user/hdoop/credit_card_project/checkpoints/credit_card_hdfs_v1
# ============================
# EXCHANGE RATE
# ============================
VCB_XML_URL=https://portal.vietcombank.com.vn/Usercontrols/TVPortal.TyGia/pXML.aspx
VCB_HTML_URL=https://www.vietcombank.com.vn/KHCN/Cong-cu-Tien-ich/Ty-gia
FX_RATE_FILE=data/usd_vnd_rate.json
FX_BASE_CURRENCY=USD
FX_QUOTE_CURRENCY=VND
FX_RATE_TYPE=transfer_buy
FX_REQUEST_TIMEOUT_SECONDS=20
